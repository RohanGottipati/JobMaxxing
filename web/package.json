{
  "name": "jobmaxxing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "postbuild": "cp -R public .next/standalone/ && cp -R .next/static .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "node --import tsx --test src/lib/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --project=public-chromium",
    "test:e2e:ui": "playwright test --ui",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked > src/types/database.generated.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "2.15.0",
    "@react-pdf/renderer": "4.5.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "9.7.1",
    "lucide-react": "^1.21.0",
    "mammoth": "1.12.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "pdf-parse": "2.4.5",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "shadcn": "^4.12.0",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
