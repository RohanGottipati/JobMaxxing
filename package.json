{
  "name": "jobmaxxing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-runtime-workers.mjs",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "postbuild": "cp -R public .next/standalone/ && cp -R .next/static .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "node --import tsx --test src/lib/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --project=public-chromium",
    "test:e2e:ui": "playwright test --ui",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked > src/types/database.generated.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "2.15.0",
    "@napi-rs/canvas": "0.1.80",
    "@react-pdf/renderer": "4.5.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "9.7.1",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.21.0",
    "mammoth": "1.12.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "^5.4.296",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^10.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.0.1",
    "shadcn": "4.22.1",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "baseline-browser-mapping": "2.11.30",
    "browserslist": "4.29.4",
    "caniuse-lite": "1.0.30001818",
    "electron-to-chromium": "1.5.463",
    "node-releases": "2.0.59",
    "ip-address": "10.7.4",
    "systeminformation": "5.33.16",
    "@modelcontextprotocol/sdk": "1.32.1",
    "body-parser": "2.4.0",
    "hono": "4.13.13",
    "on-finished": "2.4.1",
    "qs": "6.16.1"
  }
}
