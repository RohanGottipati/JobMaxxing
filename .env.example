# Supabase — get these from the project's Connect dialog or Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional AI features — server-only. Never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional social providers. Configure matching providers and callback URLs in Supabase Auth.
AUTH_GOOGLE_ENABLED=false
AUTH_GITHUB_ENABLED=false

# Public app origin for canonical URLs, social cards, and the sitemap.
# Set this to the actual HTTPS deployment origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Scope the Supabase auth cookie to a parent domain so the apex and
# www (and any subdomain) share one session and users are not logged out when
# they return on a different host. Leave unset locally (cookies stay host-only);
# by default it is derived from NEXT_PUBLIC_APP_URL. Example: jobmaxxing.app
# NEXT_PUBLIC_COOKIE_DOMAIN=jobmaxxing.app

# Optional Playwright E2E account. Use a dedicated disposable account.
E2E_EMAIL=
E2E_PASSWORD=
# E2E_BASE_URL=http://127.0.0.1:3000
