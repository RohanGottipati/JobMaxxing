# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Maxwell — server-only. Never rename this with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=your-gemini-api-key
# Optional; defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional Playwright E2E account. Use a dedicated disposable account.
E2E_EMAIL=
E2E_PASSWORD=
# E2E_BASE_URL=http://127.0.0.1:3000
